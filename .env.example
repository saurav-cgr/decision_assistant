# POSTGRES_PASSWORD, AUTH_JWT_SECRET are intentionally left blank below. They are not shared
# example defaults — `make setup` (see docs/install.md) generates real values for them, and `make
# start` will not work on the placeholder values. Do not hand-fill a shared/example value here for
# anything other than a throwaway local experiment.
POSTGRES_DB=decision_assistant
POSTGRES_USER=decision_assistant
POSTGRES_PASSWORD=
DATABASE_URL=
UPLOAD_DIRECTORY=/workspace/uploads
GENERATION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_CONFIG_VERSION=retrieval-prefix-v1
GEMINI_GENERATION_PROMPT_VERSION=gemini-json-v3
GEMINI_EMBEDDING_BATCH_SIZE=32
GEMINI_MAX_PROMPT_CHARACTERS=100000
# Optional local provider: run `docker compose --profile ollama up -d ollama`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIMENSION=768
FRONTEND_ORIGIN=http://localhost:5173
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_MINUTES=1440
MAX_UPLOAD_BYTES=26214400
MODEL_TIMEOUT_SECONDS=120
MODEL_RETRY_COUNT=2
# PDF parse budget and the process-wide Docling parse cap (DB60). Raising the cap raises peak memory.
PDF_PARSE_TIMEOUT_SECONDS=120
PDF_PARSE_CONCURRENCY=1
RERANK_ENABLED=false
RERANK_CANDIDATE_LIMIT=12
RERANK_MIN_CANDIDATES=6
RERANK_FINAL_LIMIT=5
RETRIEVAL_UNIT_STRATEGY=passage_hybrid
EVALUATION_DATASET_PATH=/workspace/evaluation/questions.json
